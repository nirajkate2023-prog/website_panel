# Postgres connection string.
#   Local, zero setup : run `npx prisma dev` and paste the URL it prints
#   Docker            : docker compose up -d, then use the URL below
#   Hosted            : Neon / Supabase / Railway connection string
#
# We connect through the node-postgres driver adapter, so pooled endpoints
# (PgBouncer, Neon pooler, Supabase pooler) work without extra flags.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/getid?schema=public"

# Secret used to sign the session cookie (min 32 chars)
SESSION_SECRET="change-me-to-a-long-random-string"
